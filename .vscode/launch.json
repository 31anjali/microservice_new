    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "DiscoveryServerApplication",
            "request": "launch",
            "mainClass": "com.tech.discoveryserver.DiscoveryServerApplication",
            "projectName": "discovery-server"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Inventory-Instance-1",
            "request": "launch",
            "mainClass": "com.tech.inventory_service.InventoryServiceApplication",
            "projectName": "inventory-service",
            "vmArgs": "-Dserver.port=0",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Inventory-Instance-2",
            "request": "launch",
            "mainClass": "com.tech.inventory_service.InventoryServiceApplication",
            "projectName": "inventory-service",
            "vmArgs": "-Dserver.port=0",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "OrderServiceApplication",
            "request": "launch",
            "mainClass": "com.tech.orderservice.OrderServiceApplication",
            "projectName": "order-service"
        },
        {
            "type": "java",
            "name": "ProductServiceApplication",
            "request": "launch",
            "mainClass": "com.tech.product_service.ProductServiceApplication",
            "projectName": "product-service"
        },
        {
            "type": "java",
            "name": "DiscoveryServerApplication",
            "request": "launch",
            "mainClass": "com.tech.discovery_server.DiscoveryServerApplication",
            "projectName": "discovery-server"
        }
    ],
        "compounds": [
        {
            "name": "Run Inventory Parallel",
            "configurations": ["Inventory-Instance-1", "Inventory-Instance-2"],
            "stopAll": true
        }
    ]
}